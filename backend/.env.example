# ==============================================================================
# Render Environment Variables (Backend)
# ==============================================================================
PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.znrmhvg.mongodb.net/serviceDesk?retryWrites=true&w=majority
JWT_SECRET=servicedesk_super_secret_jwt_key_2026

# Frontend Vercel URL for CORS (optional, defaults to allow *.vercel.app)
CLIENT_URL=https://your-frontend-app.vercel.app

# AI / LLM Configuration
AI_ENABLED=true
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback AI Provider (Optional)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
